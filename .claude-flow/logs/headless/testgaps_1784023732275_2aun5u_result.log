turns 0 at the origin when t=0\", () => {\n    expect(waveY(0, 0, 0)).toBeCloseTo(0, 5);\n  });\n  it(\"stays within the expected amplitude envelope\", () => {\n    for (let t = 0; t < 20; t += 0.37) {\n      expect(Math.abs(waveY(3, -4, t))).toBeLessThan(0.42 + 0.22 + 0.1);\n    }\n  });\n});\n```\n\n```ts\n// src/components/sections/Journey.test.ts\n// Extract computeActiveStep(v, stepCount) out of the useMotionValueEvent\n// callback first — it's currently inline and untestable in isolation.\nimport { describe, it, expect } from \"vitest\";\nimport { computeActiveStep } from \"./Journey\";\n\ndescribe(\"computeActiveStep\", () => {\n  it(\"clamps to 0 when progress is negative or zero\", () => {\n    expect(computeActiveStep(0, 3)).toBe(0);\n  });\n  it(\"clamps to the last index at progress=1\", () => {\n    expect(computeActiveStep(1, 3)).toBe(2); // Math.floor(1*3)=3, must clamp to 2\n  });\n  it(\"picks the middle step mid-scroll\", () => {\n    expect(computeActiveStep(0.5, 3)).toBe(1);\n  });\n  it(\"doesn't skip a step exactly on a boundary\", () => {\n    expect(computeActiveStep(1 / 3, 3)).toBe(1);\n  });\n});\n```\n\n---\n\n### 2. Untested components with real state/hooks\n\n**`IntroProvider` / `useIntroDone`** (`IntroProvider.tsx`)\n```tsx\n// src/components/IntroProvider.test.tsx\nimport { render, screen } from \"@testing-library/react\";\nimport { IntroProvider, useIntroDone } from \"./IntroProvider\";\n\nfunction Probe() {\n  return <span>{String(useIntroDone())}</span>;\n}\n\ndescribe(\"IntroProvider\", () => {\n  it(\"defaults consumers outside the provider to true\", () => {\n    render(<Probe />);\n    expect(screen.getByText(\"true\")).toBeInTheDocument();\n  });\n  it(\"starts false inside the provider until Preloader calls onDone\", () => {\n    render(<IntroProvider><Probe /></IntroProvider>);\n    expect(screen.getByText(\"false\")).toBeInTheDocument();\n  });\n  // it flips to true once Preloader's onDone fires — see Preloader tests below\n});\n```\n\n**`Preloader`** (`Preloader.tsx`) — the trickiest untested unit: rAF-driven progress, a `doneRef` guard against double-invoking `onDone`, and two very different code paths for `prefers-reduced-motion`.\n```tsx\n// src/components/Preloader.test.tsx\nimport { render, screen, act } from \"@testing-library/react\";\nimport Preloader from \"./Preloader\";\n\ndescribe(\"Preloader\", () => {\n  it(\"calls onDone exactly once when reduced motion is on\", () => {\n    matchMedia.mockReturnValue({ matches: true } as MediaQueryList);\n    const onDone = vi.fn();\n    render(<Preloader onDone={onDone} />);\n    act(() => vi.runAllTimers());\n    expect(onDone).toHaveBeenCalledTimes(1);\n  });\n\n  it(\"animates progress from 0 to 100 and calls onDone once at the end\", () => {\n    matchMedia.mockReturnValue({ matches: false } as MediaQueryList);\n    const onDone = vi.fn();\n    render(<Preloader onDone={onDone} />);\n    // step requestAnimationFrame + performance.now mocks to t=LOAD_MS\n    act(() => { /* advance rAF/perf.now to completion, then HOLD_MS timer */ });\n    expect(screen.getByText(\"100\")).toBeInTheDocument();\n    expect(onDone).toHaveBeenCalledTimes(1);\n  });\n\n  it(\"does not call onDone twice if unmounted mid-animation then somehow re-fires\", () => {\n    // guards doneRef.current — regression test for the double-invoke guard\n  });\n\n  it(\"resets document.documentElement.style.overflow on unmount\", () => {\n    const { unmount } = render(<Preloader onDone={() => {}} />);\n    unmount();\n    expect(document.documentElement.style.overflow).toBe(\"\");\n  });\n});\n```\n\n**`SmoothScroll`** (`SmoothScroll.tsx`)\n```tsx\n// src/components/SmoothScroll.test.tsx\ndescribe(\"SmoothScroll\", () => {\n  it(\"does not construct Lenis when prefers-reduced-motion is set\", () => {\n    matchMedia.mockReturnValue({ matches: true });\n    render(<SmoothScroll><div>child</div></SmoothScroll>);\n    expect(LenisMock).not.toHaveBeenCalled();\n  });\n  it(\"constructs Lenis and starts an rAF loop otherwise\", () => { /* ... */ });\n  it(\"destroys Lenis and cancels rAF on unmount\", () => {\n    const { unmount } = render(<SmoothScroll><div /></SmoothScroll>);\n    unmount();\n    expect(LenisMock.mock.instances[0].destroy).toHaveBeenCalled();\n  });\n  it(\"always renders children regardless of motion preference\", () => {\n    render(<SmoothScroll><div>child</div></SmoothScroll>);\n    expect(screen.getByText(\"child\")).toBeInTheDocument();\n  });\n});\n```\n\n**`Nav`** (`Nav.tsx`) — has the most branching client state in the app.\n```tsx\n// src/components/Nav.test.tsx\ndescribe(\"Nav\", () => {\n  it(\"is not scrolled-styled before scrollY exceeds 48\", () => {\n    window.scrollY = 0;\n    render(<Nav />);\n    fireEvent.scroll(window);\n    expect(screen.getByRole(\"banner\")).not.toHaveClass(\"bg-midnight/95\");\n  });\n  it(\"applies scrolled styling once scrollY passes 48\", () => {\n    window.scrollY = 49;\n    render(<Nav />);\n    fireEvent.scroll(window);\n    expect(screen.getByRole(\"banner\")).toHaveClass(\"bg-midnight/95\");\n  });\n  it(\"boundary: scrollY exactly 48 is NOT scrolled (uses > not >=)\", () => {\n    window.scrollY = 48;\n    render(<Nav />);\n    fireEvent.scroll(window);\n    expect(screen.getByRole(\"banner\")).not.toHaveClass(\"bg-midnight/95\");\n  });\n  it(\"toggles aria-expanded and locks body scroll when the mobile menu opens\", () => {\n    render(<Nav />);\n    fireEvent.click(screen.getByRole(\"button\", { name: /open menu/i }));\n    expect(screen.getByRole(\"button\", { name: /close menu/i })).toHaveAttribute(\"aria-expanded\", \"true\");\n    expect(document.documentElement.style.overflow).toBe(\"hidden\");\n  });\n  it(\"clicking a link inside the open mobile menu closes it\", () => {\n    render(<Nav />);\n    fireEvent.click(screen.getByRole(\"button\", { name: /open menu/i }));\n    fireEvent.click(screen.getAllByText(\"About\")[1]); // mobile menu link\n    expect(document.documentElement.style.overflow).toBe(\"\");\n  });\n  it(\"removes the scroll listener and resets overflow on unmount\", () => { /* ... */ });\n});\n```\n\n**`MagneticButton`** (`MagneticButton.tsx`)\n```tsx\n// src/components/ui/MagneticButton.test.tsx\ndescribe(\"MagneticButton\", () => {\n  it(\"renders an <a> when href is provided, a <button> otherwise\", () => {\n    const { rerender } = render(<MagneticButton href=\"/x\">Go</MagneticButton>);\n    expect(screen.getByRole(\"link\")).toBeInTheDocument();\n    rerender(<MagneticButton onClick={vi.fn()}>Go</MagneticButton>);\n    expect(screen.getByRole(\"button\")).toBeInTheDocument();\n  });\n  it(\"calls onClick when rendered as a button\", () => {\n    const onClick = vi.fn();\n    render(<MagneticButton onClick={onClick}>Go</MagneticButton>);\n    fireEvent.click(screen.getByRole(\"button\"));\n    expect(onClick).toHaveBeenCalled();\n  });\n  it(\"ignores non-mouse pointer types (touch/pen) for the magnetic offset\", () => {\n    render(<MagneticButton href=\"/x\">Go</MagneticButton>);\n    fireEvent.pointerMove(screen.getByRole(\"link\").parentElement!, { pointerType: \"touch\", clientX: 999, clientY: 999 });\n    // assert underlying motion value stayed at 0 — needs a motion/react mock\n  });\n  it(\"does nothing on pointer move when prefers-reduced-motion is set\", () => { /* ... */ });\n  it(\"resets offset to 0 on pointer leave\", () => { /* ... */ });\n});\n```\n\n**`RevealWords` / `FadeUp`** (`Reveal.tsx`)\n```tsx\n// src/components/ui/Reveal.test.tsx\ndescribe(\"RevealWords\", () => {\n  it(\"splits text into one span per word\", () => {\n    render(<RevealWords text=\"one two three\" />);\n    expect(screen.getAllByText(/one|two|three/)).toHaveLength(3);\n  });\n  it(\"applies accentClassName only to words in the accent list (exact match)\", () => {\n    render(<RevealWords text=\"built on trust,\" accent={[\"trust,\"]} />);\n    expect(screen.getByText(\"trust,\")).toHaveClass(\"italic\");\n  });\n  it(\"EDGE CASE: accent word without matching punctuation is NOT styled\", () => {\n    // accent=[\"trust\"] but text contains \"trust,\" — exact-match miss, silent bug\n    render(<RevealWords text=\"built on trust,\" accent={[\"trust\"]} />);\n    expect(screen.getByText(\"trust,\")).not.toHaveClass(\"italic\");\n  });\n  it(\"renders plain, unanimated spans when prefers-reduced-motion is set\", () => {\n    mockUseReducedMotion(true);\n    render(<RevealWords text=\"a b\" as=\"h2\" />);\n    expect(screen.getByRole(\"heading\")).toBeInTheDocument();\n  });\n});\n\ndescribe(\"FadeUp\", () => {\n  it(\"renders a plain div (no motion wrapper) under reduced motion\", () => {\n    mockUseReducedMotion(true);\n    render(<FadeUp>child</FadeUp>);\n    expect(screen.getByText(\"child\").tagName).toBe(\"DIV\");\n  });\n});\n```\n\n**`Products`** — the one component with a genuine, non-obvious business rule.\n```tsx\n// src/components/sections/Products.test.tsx\ndescribe(\"Products\", () => {\n  it(\"defaults the preview panel to the first product\", () => {\n    render(<Products />);\n    expect(screen.getByText(\"Specialised Investment Funds\", { selector: \".font-display.text-lg\" })).toBeInTheDocument();\n  });\n  it(\"hovering a row updates both active state and the preview panel\", () => {\n    render(<Products />);\n    fireEvent.mouseEnter(screen.getByText(\"Mutual Funds\"));\n    expect(screen.getByText(\"Mutual Funds\", { selector: \".font-display.text-lg\" })).toBeInTheDocument();\n  });\n  it(\"EDGE CASE: leaving a row clears the active highlight but the preview panel keeps showing the last-hovered product\", () => {\n    render(<Products />);\n    fireEvent.mouseEnter(screen.getByText(\"Mutual Funds\"));\n    fireEvent.mouseLeave(screen.getByText(\"Mutual Funds\"));\n    // activeIndex -> null (no row highlighted) but previewIndex is untouched\n    expect(screen.getByText(\"Mutual Funds\", { selector: \".font-display.text-lg\" })).toBeInTheDocument();\n  });\n  it(\"keyboard focus activates a row the same way mouse hover does\", () => {\n    render(<Products />);\n    fireEvent.focus(screen.getByText(\"Portfolio Management Services\"));\n    expect(screen.getByText(\"Portfolio Management Services\", { selector: \".font-display.text-lg\" })).toBeInTheDocument();\n  });\n});\n```\n\n**`MarketConstellation`** — needs either a `@react-three/fiber`/`three` canvas mock or is deliberately left to Playwright/visual smoke tests. At minimum, cover the reduced-motion branch:\n```tsx\n// src/components/three/MarketConstellation.test.tsx\ndescribe(\"MarketConstellation\", () => {\n  it(\"uses frameloop='demand' when prefers-reduced-motion matches\", () => {\n    matchMedia.mockReturnValue({ matches: true, addEventListener: vi.fn(), removeEventListener: vi.fn() });\n    render(<MarketConstellation />);\n    // assert <Canvas frameloop=\"demand\" ...> — mock @react-three/fiber's Canvas\n  });\n  it(\"falls back to false (non-reduced) on the server snapshot\", () => {\n    // getServerSnapshot always returns false — verify no hydration mismatch warning\n  });\n});\n```\n\n**`AboutPage` / `CompassSeal` / `rise()`**\n```tsx\n// src/components/pages/AboutPage.test.tsx\ndescribe(\"CompassSeal\", () => {\n  it(\"renders 24 tick marks for the amfi variant and 8 for sebi\", () => {\n    const { container: amfi } = render(<svg><CompassSeal variant=\"amfi\" /></svg>);\n    expect(amfi.querySelectorAll(\"line\")).toHaveLength(24);\n    const { container: sebi } = render(<svg><CompassSeal variant=\"sebi\" /></svg>);\n    expect(sebi.querySelectorAll(\"line\")).toHaveLength(8);\n  });\n});\n\ndescribe(\"AboutPage\", () => {\n  it(\"renders the hero animation only once the intro is done\", () => {\n    render(<AboutPage />);\n    // before Preloader's onDone fires, `ready` is false so rise() initial states hold\n  });\n});\n```\n\n---\n\n### 3. Edge cases not covered anywhere today\n- `prefers-reduced-motion: reduce` branch for **every** animated component (Preloader, SmoothScroll, Nav, MagneticButton, RevealWords, FadeUp, Products, Journey, Testimonials, Manifesto, Trust seals, CTA compass, MarketConstellation) — currently untested in both directions.\n- `Nav` scroll boundary at exactly `scrollY === 48` (uses `>`, not `>=`).\n- `Preloader`'s `doneRef` guard against calling `onDone` more than once.\n- `Products`: preview panel state after `onDeactivate` (sticky vs. reset) — see above.\n- `MagneticButton`: `pointerType !== \"mouse\"` (touch/pen) explicitly ignored.\n- `Journey`: `scrollYProgress` at exactly `0` and `1` (clamp boundaries).\n- SSR/client determinism for precomputed geometry (`CTA.tsx` TICKS, `Trust.tsx` ticks(), `MarketConstellation` terrain) — a floating-point mismatch here causes a silent hydration warning, not a crash, so nothing today would catch a regression.\n- `RevealWords` accent matching is exact-string (`accent.includes(word)`) — words with different trailing punctuation than the accent array silently fail to style (shown above).\n\n### 4. Missing error-handling tests\nThere is **no error handling anywhere in the codebase** — no error boundaries, no try/catch, no `.catch()`, no fallback UI. Concretely untested failure modes:\n- `MarketConstellation`'s `<Canvas>` mounts unconditionally; if WebGL is unavailable (headless CI, older device, disabled GPU), `@react-three/fiber` throws during context creation and there's no error boundary to catch it — it would take down the whole `Home` page. Worth a test asserting an error boundary exists/catches this, or an explicit decision to accept the risk.\n- `SmoothScroll` calls `new Lenis(...)` with no guard; if Lenis throws (e.g., unsupported browser), the effect throws and nothing recovers.\n- No test for `window.matchMedia` being `undefined` (some older/embedded browsers) — every reduced-motion check (`Nav`, `Preloader`, `MagneticButton`, `MarketConstellation`, etc.) would throw at once.\n- `AboutPage`'s `<Image>` team photos have no `onError` fallback — a broken image path renders a blank box silently, untested.\n\n### 5. Integration test gaps\n- **Smoke test**: `Home` and `About` render fully without throwing (catches the WebGL/Lenis crash risk above cheaply).\n- **Preloader → IntroProvider → Nav sequencing**: the curtain lifts, `useIntroDone()` flips true, and only then do `Nav`/`Hero` animate in — untested as a sequence, only as isolated units.\n- **Anchor navigation**: `/#products`, `/#journey`, `/#trust`, `/#contact` from `Nav`/`Footer` actually land on elements with those `id`s (`Products`, `Journey`, `Trust`, `CTA` all define matching `id`s — easy to silently drift).\n- **Cross-page navigation**: Home ↔ About via `Nav`'s \"About\" link and Footer's \"About Us\" link.\n- **Mobile nav open/close E2E**: overflow lock engages/releases correctly across a real viewport resize.\n- **Reduced-motion E2E** (Playwright `contextOptions.reducedMotion: 'reduce'`): preloader should skip instantly, `Journey`'s scrollytelling should fall back to the static stacked list, `CTA`'s compass rose shouldn't spin.\n\n```ts\n// e2e/home.spec.ts (Playwright)\nimport { test, expect } from \"@playwright/test\";\n\ntest(\"home page renders all sections without console errors\", async ({ page }) => {\n  const errors: string[] = [];\n  page.on(\"pageerror\", (e) => errors.push(e.message));\n  await page.goto(\"/\");\n  await expect(page.getByRole(\"heading\", { level: 1 })).toBeVisible();\n  for (const id of [\"products\", \"journey\", \"trust\", \"contact\"]) {\n    await expect(page.locator(`#${id}`)).toBeVisible();\n  }\n  expect(errors).toEqual([]);\n});\n\ntest(\"nav anchor links scroll to the right section\", async ({ page }) => {\n  await page.goto(\"/\");\n  await page.getByRole(\"link\", { name: \"Why Platizio\" }).click();\n  await expect(page.locator(\"#trust\")).toBeInViewport();\n});\n\ntest.describe(\"reduced motion\", () => {\n  test.use({ reducedMotion: \"reduce\" });\n  test(\"preloader is skipped and content is immediately interactive\", async ({ page }) => {\n    await page.goto(\"/\");\n    await expect(page.getByRole(\"banner\")).toBeVisible({ timeout: 500 });\n  });\n});\n```\n\n---\n\n**Summary**: this is a from-scratch test-coverage problem, not a \"fill the gaps\" one. Priority order I'd suggest: (1) install Vitest+RTL+Playwright, (2) unit-test the pure functions (`waveY`, `ticks`, extracted `computeActiveStep`) since they need zero mocking, (3) cover `Preloader`/`Nav`/`Products`/`MagneticButton` state machines, (4) add the handful of Playwright smoke/E2E specs above to close the error-handling and integration gaps cheaply. Want me to scaffold the test setup and commit a first batch of these?\n",
