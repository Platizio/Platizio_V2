        "language": "jsonc",
        "code": "// package.json — suggested addition\n\"scripts\": { \"test\": \"vitest run\", \"test:watch\": \"vitest\" },\n\"devDependencies\": { \"vitest\": \"^2\", \"@testing-library/react\": \"^16\", \"@testing-library/jest-dom\": \"^6\", \"jsdom\": \"^25\" }"
      },
      {
        "language": "ts",
        "code": "// src/lib/content-types.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { anchorId, buildToc, readingMinutes } from \"./content-types\";\nimport type { RichBlock } from \"./content-types\";\n\ndescribe(\"anchorId\", () => {\n  it(\"slugifies basic text\", () => {\n    expect(anchorId(\"What is an AIF?\")).toBe(\"what-is-an-aif\");\n  });\n  it(\"strips punctuation-only input to empty string\", () => {\n    expect(anchorId(\"???\")).toBe(\"\");\n  });\n  it(\"truncates to 60 chars\", () => {\n    const long = \"a \".repeat(50);\n    expect(anchorId(long).length).toBeLessThanOrEqual(60);\n  });\n  it(\"handles unicode without throwing\", () => {\n    expect(() => anchorId(\"₹50 lakh — क्या?\")).not.toThrow();\n  });\n});\n\ndescribe(\"buildToc\", () => {\n  it(\"returns empty array when no h2 blocks exist\", () => {\n    const blocks: RichBlock[] = [{ kind: \"p\", text: \"hello\" }];\n    expect(buildToc(blocks)).toEqual([]);\n  });\n  it(\"extracts only h2, ignoring h3/p/etc\", () => {\n    const blocks: RichBlock[] = [\n      { kind: \"h2\", text: \"Section One\" },\n      { kind: \"h3\", text: \"Subsection\" },\n      { kind: \"p\", text: \"text\" },\n    ];\n    expect(buildToc(blocks)).toEqual([{ id: \"section-one\", text: \"Section One\" }]);\n  });\n  it(\"produces duplicate ids for duplicate headings (documents current behavior)\", () => {\n    const blocks: RichBlock[] = [\n      { kind: \"h2\", text: \"Overview\" },\n      { kind: \"h2\", text: \"Overview\" },\n    ];\n    const toc = buildToc(blocks);\n    expect(toc[0].id).toBe(toc[1].id); // flags a real anchor-collision risk\n  });\n});\n\ndescribe(\"readingMinutes\", () => {\n  it(\"returns at least 1 minute for empty content\", () => {\n    expect(readingMinutes([])).toBe(1);\n  });\n  it(\"counts words inside table rows\", () => {\n    const blocks: RichBlock[] = [\n      { kind: \"table\", columns: [\"A\"], rows: [[\"one two three four five\"]] },\n    ];\n    expect(readingMinutes(blocks)).toBe(1);\n  });\n  it(\"scales roughly with word count at 200wpm\", () => {\n    const words = Array(400).fill(\"word\").join(\" \");\n    const blocks: RichBlock[] = [{ kind: \"p\", text: words }];\n    expect(readingMinutes(blocks)).toBe(2);\n  });\n});"
      },
      {
        "language": "ts",
        "code": "// src/lib/articles.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { ARTICLES, ARTICLES_SORTED, CATEGORY_GLYPH, getArticle, getArticleBody } from \"./articles\";\nimport { ARTICLE_BODIES } from \"@/content/articles\";\nimport { PRODUCT_GLYPHS } from \"@/lib/productGlyphs\";\n\ndescribe(\"getArticle\", () => {\n  it(\"returns undefined for unknown slug\", () => {\n    expect(getArticle(\"does-not-exist\")).toBeUndefined();\n  });\n  it(\"returns the matching article for a known slug\", () => {\n    expect(getArticle(\"market-outlook-2025\")?.title).toContain(\"Market Outlook\");\n  });\n});\n\ndescribe(\"getArticleBody\", () => {\n  it(\"falls back to [] instead of throwing for an unknown slug\", () => {\n    expect(getArticleBody(\"nope\")).toEqual([]);\n  });\n});\n\ndescribe(\"data integrity\", () => {\n  it(\"every ARTICLES slug has a corresponding ARTICLE_BODIES entry\", () => {\n    const missing = ARTICLES.filter((a) => !(a.slug in ARTICLE_BODIES));\n    expect(missing.map((a) => a.slug)).toEqual([]);\n  });\n  it(\"every ARTICLE_BODIES key still has a matching ARTICLES entry (no orphans)\", () => {\n    const slugs = new Set(ARTICLES.map((a) => a.slug));\n    const orphans = Object.keys(ARTICLE_BODIES).filter((k) => !slugs.has(k));\n    expect(orphans).toEqual([]);\n  });\n  it(\"CATEGORY_GLYPH maps to a real PRODUCT_GLYPHS key for every category in use\", () => {\n    for (const glyphKey of Object.values(CATEGORY_GLYPH)) {\n      expect(PRODUCT_GLYPHS[glyphKey]).toBeDefined();\n    }\n  });\n});\n\ndescribe(\"ARTICLES_SORTED\", () => {\n  it(\"is sorted newest-first by iso date\", () => {\n    const isos = ARTICLES_SORTED.map((a) => a.iso);\n    const sorted = [...isos].sort().reverse();\n    expect(isos).toEqual(sorted);\n  });\n  it(\"does not mutate the original ARTICLES array\", () => {\n    expect(ARTICLES[0]).toEqual(ARTICLES[0]); // ARTICLES_SORTED must not reorder ARTICLES in place\n    expect(ARTICLES.map((a) => a.slug)).not.toEqual(ARTICLES_SORTED.map((a) => a.slug) /* only if source order differs */);\n  });\n});"
      },
      {
        "language": "ts",
        "code": "// src/lib/legal.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { getLegalDoc, LEGAL_DOCS } from \"./legal\";\n\ndescribe(\"getLegalDoc\", () => {\n  it(\"returns undefined for an unknown id (no throw)\", () => {\n    expect(getLegalDoc(\"nonexistent\")).toBeUndefined();\n  });\n  it(\"returns the doc for each registered id\", () => {\n    for (const id of Object.keys(LEGAL_DOCS)) {\n      expect(getLegalDoc(id)?.id).toBe(id);\n    }\n  });\n  it(\"every doc has non-empty blocks (catches an accidentally emptied legal doc)\", () => {\n    for (const doc of Object.values(LEGAL_DOCS)) {\n      expect(doc.blocks.length).toBeGreaterThan(0);\n    }\n  });\n});"
      },
      {
        "language": "ts",
        "code": "// src/lib/products.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { PRODUCTS, getProduct, RISK_DISCLAIMER } from \"./products\";\n\ndescribe(\"getProduct\", () => {\n  it(\"returns undefined for an unknown slug instead of throwing\", () => {\n    expect(getProduct(\"not-a-real-product\")).toBeUndefined();\n  });\n  it(\"resolves every declared product slug\", () => {\n    for (const p of PRODUCTS) {\n      expect(getProduct(p.slug)?.slug).toBe(p.slug);\n    }\n  });\n  it(\"has no duplicate slugs (would silently overwrite in PRODUCT_MAP)\", () => {\n    const slugs = PRODUCTS.map((p) => p.slug);\n    expect(new Set(slugs).size).toBe(slugs.length);\n  });\n  it(\"exposes the shared risk disclaimer text\", () => {\n    expect(RISK_DISCLAIMER).toMatch(/market risks/i);\n  });\n});"
      },
