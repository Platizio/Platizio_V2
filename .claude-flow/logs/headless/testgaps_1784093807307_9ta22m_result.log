        "title": "5. `src/components/site/RichText.tsx` — rendering + a real edge case",
        "content": "The `switch` has **no `default` case**, so an unrecognized `RichBlock.kind` (e.g. a future block type added to the union but not to this switch) silently renders nothing — no error, no dev warning. That's a genuine missing-error-handling gap worth a regression test.\n\n```tsx\n// src/components/site/RichText.test.tsx\nimport { describe, it, expect } from \"vitest\";\nimport { render, screen } from \"@testing-library/react\";\nimport RichText from \"./RichText\";\nimport type { RichBlock } from \"@/lib/content-types\";\n\ndescribe(\"RichText\", () => {\n  it.each<RichBlock>([\n    { kind: \"p\", text: \"paragraph\" },\n    { kind: \"h2\", text: \"Heading Two\" },\n    { kind: \"h3\", text: \"Heading Three\" },\n    { kind: \"ul\", items: [\"a\", \"b\"] },\n    { kind: \"ol\", items: [\"a\", \"b\"] },\n    { kind: \"quote\", text: \"a quote\" },\n    { kind: \"note\", text: \"a note\" },\n    { kind: \"table\", columns: [\"A\"], rows: [[\"1\"]] },\n  ])(\"renders block kind %o without throwing\", (block) => {\n    expect(() => render(<RichText blocks={[block]} />)).not.toThrow();\n  });\n\n  it(\"assigns an anchor id to h2 headings for ToC linking\", () => {\n    render(<RichText blocks={[{ kind: \"h2\", text: \"What is an AIF?\" }]} />);\n    expect(screen.getByRole(\"heading\", { level: 2 })).toHaveAttribute(\"id\", \"what-is-an-aif\");\n  });\n\n  it(\"renders nothing (no crash, no content) for an unrecognized block kind — documents a silent-failure gap\", () => {\n    const bogus = { kind: \"video\", text: \"x\" } as unknown as RichBlock;\n    const { container } = render(<RichText blocks={[bogus]} />);\n    expect(container.textContent).toBe(\"\"); // currently silent; consider a fallback/console.warn\n  });\n\n  it(\"renders table rows/columns in order\", () => {\n    render(\n      <RichText\n        blocks={[{ kind: \"table\", columns: [\"Category\"], rows: [[\"Equity\"], [\"Debt\"]] }]}\n      />\n    );\n    expect(screen.getAllByRole(\"row\")).toHaveLength(3); // header + 2 rows\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "6. `src/components/pages/InsightsIndex.tsx` — untested client interaction",
        "content": "The category filter (`useState` + `.filter`) is the only piece of interactive state logic in the content pages, and it's fully untested. Also worth checking: is `active` category still valid if `CATEGORIES` changes (not really an issue), and that filtering by a category with zero articles renders an empty grid instead of erroring.\n\n```tsx\n// src/components/pages/InsightsIndex.test.tsx\nimport { describe, it, expect } from \"vitest\";\nimport { render, screen } from \"@testing-library/react\";\nimport userEvent from \"@testing-library/user-event\";\nimport InsightsIndex from \"./InsightsIndex\";\n\ndescribe(\"InsightsIndex category filter\", () => {\n  it(\"shows all articles by default\", () => {\n    render(<InsightsIndex />);\n    expect(screen.getByRole(\"button\", { name: \"All\", pressed: true })).toBeInTheDocument();\n  });\n\n  it(\"filters to only the selected category on click\", async () => {\n    const user = userEvent.setup();\n    render(<InsightsIndex />);\n    await user.click(screen.getByRole(\"button\", { name: \"PMS\" }));\n    const categoryLabels = screen.getAllByText(\"PMS\");\n    expect(categoryLabels.length).toBeGreaterThan(0);\n    expect(screen.queryByText(\"AIF\")).not.toBeInTheDocument();\n  });\n\n  it(\"returns to the full list when 'All' is re-selected\", async () => {\n    const user = userEvent.setup();\n    render(<InsightsIndex />);\n    await user.click(screen.getByRole(\"button\", { name: \"SIF\" }));\n    await user.click(screen.getByRole(\"button\", { name: \"All\" }));\n    expect(screen.getByRole(\"button\", { name: \"All\", pressed: true })).toBeInTheDocument();\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "7. Integration gaps — dynamic routes (`insights/[slug]`, `products/[slug]`)",
        "content": "These are the only real \"control flow\" in the app (404 handling), and there is no test proving `notFound()` actually fires for a bad slug, nor that `generateStaticParams`/`generateMetadata` produce correct output. This is the biggest **integration test gap** — everything else above is unit-level; this is where routing and content resolution meet.\n\n```ts\n// src/app/insights/[slug]/page.test.tsx\nimport { describe, it, expect, vi } from \"vitest\";\n\nvi.mock(\"next/navigation\", () => ({ notFound: vi.fn(() => { throw new Error(\"NEXT_NOT_FOUND\"); }) }));\n\nimport { generateStaticParams, generateMetadata } from \"./page\";\nimport Page from \"./page\";\nimport { notFound } from \"next/navigation\";\n\ndescribe(\"insights/[slug] route\", () => {\n  it(\"generateStaticParams enumerates every article slug\", () => {\n    const params = generateStaticParams();\n    expect(params).toContainEqual({ slug: \"market-outlook-2025\" });\n  });\n\n  it(\"generateMetadata returns {} for an unknown slug instead of throwing\", async () => {\n    const meta = await generateMetadata({ params: Promise.resolve({ slug: \"unknown\" }) });\n    expect(meta).toEqual({});\n  });\n\n  it(\"generateMetadata returns the article's title/description for a known slug\", async () => {\n    const meta = await generateMetadata({ params: Promise.resolve({ slug: \"market-outlook-2025\" }) });\n    expect(meta.title).toMatch(/Market Outlook/);\n  });\n\n  it(\"calls notFound() for an unknown slug\", async () => {\n    await expect(Page({ params: Promise.resolve({ slug: \"unknown\" }) })).rejects.toThrow();\n    expect(notFound).toHaveBeenCalled();\n  });\n});\n```\nSame skeleton applies verbatim to `src/app/products/[slug]/page.tsx` (swap `ARTICLES`/`getArticle`/`getArticleBody` for `PRODUCTS`/`getProduct`).\n\n---\n\n",
        "level": 3
      },
      {
        "title": "Priority ranking",
        "content": "| Priority | Area | Why |\n|---|---|---|\n| 1 | Test infra setup | Nothing else is possible without it |\n| 2 | `articles.ts` / `legal.ts` data-integrity checks | Silent-fallback bugs (empty body/doc) would ship undetected — highest real-world risk given this is a content site |\n| 3 | Dynamic route `notFound()` behavior | Only real control-flow/error-handling path in the app |\n| 4 | `content-types.ts` pure functions | Cheap, high-value, feeds SEO anchors |\n| 5 | `RichText.tsx` per-kind rendering + unknown-kind case | Prevents future block-type additions from silently no-op rendering |\n| 6 | `InsightsIndex` filter interaction | Only client-state logic in the content pages |\n| 7 | `products.tsx` / `productGlyphs.tsx` cross-checks | Lower risk (only 5 fixed products, unlikely to drift) but cheap to add alongside #2 |",
        "level": 3
      }
    ],
    "codeBlocks": [
