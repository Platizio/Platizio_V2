        "language": "ts",
        "code": "// src/lib/content-types.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { anchorId, buildToc, readingMinutes } from \"@/lib/content-types\";\n\ndescribe(\"anchorId\", () => {\n  it(\"lowercases and hyphenates a normal heading\", () => {\n    expect(anchorId(\"What is an AIF?\")).toBe(\"what-is-an-aif\");\n  });\n  it(\"strips punctuation not part of word/space\", () => {\n    expect(anchorId(\"Category I (growth/impact oriented):\")).toBe(\"category-i-growthimpact-oriented\");\n  });\n  it(\"collapses repeated whitespace\", () => {\n    expect(anchorId(\"Two   spaces\\tand\\nnewline\")).toBe(\"two-spaces-and-newline\");\n  });\n  it(\"returns empty string for empty input\", () => {\n    expect(anchorId(\"\")).toBe(\"\");\n  });\n  it(\"truncates to 60 chars without throwing on multibyte input\", () => {\n    const long = \"a\".repeat(80);\n    expect(anchorId(long)).toHaveLength(60);\n  });\n  it(\"produces the same id for two headings with the same text (documents current collision behavior)\", () => {\n    expect(anchorId(\"Risk\")).toBe(anchorId(\"Risk\"));\n  });\n});"
      },
      {
        "language": "ts",
        "code": "describe(\"buildToc\", () => {\n  it(\"returns [] when there are no h2 blocks\", () => {\n    expect(buildToc([{ kind: \"p\", text: \"x\" }])).toEqual([]);\n  });\n  it(\"extracts only h2 blocks, ignoring h3/p/ul/etc\", () => {\n    const blocks: RichBlock[] = [\n      { kind: \"h2\", text: \"Intro\" },\n      { kind: \"h3\", text: \"Sub\" },\n      { kind: \"p\", text: \"body\" },\n      { kind: \"h2\", text: \"Next\" },\n    ];\n    expect(buildToc(blocks)).toEqual([\n      { id: \"intro\", text: \"Intro\" },\n      { id: \"next\", text: \"Next\" },\n    ]);\n  });\n  it(\"does not dedupe colliding anchor ids from duplicate headings\", () => {\n    const blocks: RichBlock[] = [{ kind: \"h2\", text: \"Risk\" }, { kind: \"h2\", text: \"Risk\" }];\n    const toc = buildToc(blocks);\n    expect(toc[0].id).toBe(toc[1].id); // documents the current gap\n  });\n});"
      },
