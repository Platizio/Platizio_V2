        "content": "\n**`getArticle(slug)`** / **`getArticleBody(slug)`** (`articles.ts:171-177`)\nUntested: unknown slug (`getArticle` → `undefined`; `getArticleBody` → `[]`, not `undefined` — asymmetric contract worth locking down), empty-string slug, case sensitivity (slug matching is exact — a differently-cased slug should miss).\n\n**`ARTICLES_SORTED`** (`articles.ts:167`)\nUntested: sort order (newest-first by ISO date), stability when dates collide, and — critically — a **data-integrity check that's currently nowhere**: every `ARTICLES[].slug` must have a matching key in `ARTICLE_BODIES` (`src/content/articles/index.ts`), or `getArticleBody` silently returns `[]` and a real article renders with no body in production.\n\n```ts\n// src/lib/articles.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { ARTICLES, ARTICLES_SORTED, CATEGORY_GLYPH, getArticle, getArticleBody } from \"@/lib/articles\";\nimport { ARTICLE_BODIES } from \"@/content/articles\";\nimport { PRODUCT_GLYPHS } from \"@/lib/productGlyphs\";\n\ndescribe(\"getArticle\", () => {\n  it(\"returns the matching article\", () => {\n    expect(getArticle(\"market-outlook-2025\")?.title).toContain(\"Market Outlook\");\n  });\n  it(\"returns undefined for an unknown slug\", () => {\n    expect(getArticle(\"does-not-exist\")).toBeUndefined();\n  });\n  it(\"is case-sensitive\", () => {\n    expect(getArticle(\"MARKET-OUTLOOK-2025\")).toBeUndefined();\n  });\n});\n\ndescribe(\"getArticleBody\", () => {\n  it(\"returns [] (not undefined) for an unknown slug\", () => {\n    expect(getArticleBody(\"does-not-exist\")).toEqual([]);\n  });\n});\n\ndescribe(\"ARTICLES_SORTED\", () => {\n  it(\"orders articles newest-first by iso date\", () => {\n    const isos = ARTICLES_SORTED.map((a) => a.iso);\n    expect(isos).toEqual([...isos].sort().reverse());\n  });\n});\n\ndescribe(\"data integrity\", () => {\n  it(\"every article slug has a corresponding ARTICLE_BODIES entry\", () => {\n    for (const a of ARTICLES) {\n      expect(ARTICLE_BODIES[a.slug], `missing body for \"${a.slug}\"`).toBeDefined();\n    }\n  });\n  it(\"every article slug is unique\", () => {\n    const slugs = ARTICLES.map((a) => a.slug);\n    expect(new Set(slugs).size).toBe(slugs.length);\n  });\n  it(\"every CATEGORY_GLYPH value maps to a real PRODUCT_GLYPHS entry\", () => {\n    for (const glyphKey of Object.values(CATEGORY_GLYPH)) {\n      expect(PRODUCT_GLYPHS[glyphKey]).toBeDefined();\n    }\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "3. `src/lib/legal.ts` — untested",
        "content": "\n**`getLegalDoc(id)`** (`legal.ts:53`) — untested: unknown id → `undefined`; and no test asserts `path` uniqueness or that every `LEGAL_DOCS[key].id === key` (a typo here would silently break routing).\n\n```ts\n// src/lib/legal.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { LEGAL_DOCS, getLegalDoc } from \"@/lib/legal\";\n\ndescribe(\"getLegalDoc\", () => {\n  it(\"returns undefined for an unknown id\", () => {\n    expect(getLegalDoc(\"nope\")).toBeUndefined();\n  });\n});\n\ndescribe(\"LEGAL_DOCS integrity\", () => {\n  it(\"each entry's id matches its registry key\", () => {\n    for (const [key, doc] of Object.entries(LEGAL_DOCS)) {\n      expect(doc.id).toBe(key);\n    }\n  });\n  it(\"all paths are unique\", () => {\n    const paths = Object.values(LEGAL_DOCS).map((d) => d.path);\n    expect(new Set(paths).size).toBe(paths.length);\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "4. `src/lib/products.tsx` — untested",
        "content": "\n**`getProduct(slug)`** (`products.tsx:521`) and **`PRODUCT_MAP`** — untested: unknown slug, and the `tag` → `PRODUCT_GLYPHS` link (`products.tsx:66,100,189,280,353,436`) which is a string-keyed lookup with no compile-time guarantee it resolves.\n\n```ts\n// src/lib/products.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { PRODUCTS, PRODUCT_MAP, getProduct, RISK_DISCLAIMER } from \"@/lib/products\";\nimport { PRODUCT_GLYPHS } from \"@/lib/productGlyphs\";\n\ndescribe(\"getProduct\", () => {\n  it(\"returns undefined for an unknown slug\", () => {\n    expect(getProduct(\"crypto\")).toBeUndefined();\n  });\n  it(\"returns the same object as PRODUCT_MAP for a known slug\", () => {\n    expect(getProduct(\"sif\")).toBe(PRODUCT_MAP.sif);\n  });\n});\n\ndescribe(\"PRODUCTS data integrity\", () => {\n  it(\"every product's tag resolves to a real glyph\", () => {\n    for (const p of PRODUCTS) {\n      expect(PRODUCT_GLYPHS[p.tag], `missing glyph for tag \"${p.tag}\" on ${p.slug}`).toBeDefined();\n    }\n  });\n  it(\"every product slug is unique\", () => {\n    const slugs = PRODUCTS.map((p) => p.slug);\n    expect(new Set(slugs).size).toBe(slugs.length);\n  });\n});\n\ndescribe(\"RISK_DISCLAIMER\", () => {\n  it(\"is non-empty (compliance-critical copy must never go blank)\", () => {\n    expect(RISK_DISCLAIMER.length).toBeGreaterThan(0);\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "5. `ContactPage.tsx` — untested business logic (highest-value gap)",
        "content": "\n`buildEnquiry(data: FormData)` (`ContactPage.tsx:34`) constructs the WhatsApp/email message body — this is the one piece of real logic in the whole content site (whitespace trimming, conditional optional lines, message assembly) and it's currently a private, unexported function with **no test coverage and no error-handling around malformed input**.\n\n- Missing edge cases: empty `FormData` (all fields `\"\"`), fields with only whitespace (must trim to `\"\"` and still omit optional lines), `product`/`message` present vs. absent (conditional `lines.push`), values containing newlines or WhatsApp-breaking characters, non-string `FormData` values (e.g. a `File` if a name attribute collided — `String(data.get(...))` coercion).\n- Missing integration coverage: `onSubmit` calling `window.open` with a properly `encodeURIComponent`-escaped `wa.me` URL; `emailInstead` bailing out via `form.reportValidity()` when required fields are empty (no test proves the native-validation short-circuit actually prevents a mailto: from firing).\n\nTo make this testable, export `buildEnquiry` from the module (or extract it to `src/lib/contact.ts`):\n\n```ts\n// src/lib/contact.test.ts  (after extracting buildEnquiry to a testable module)\nimport { describe, it, expect } from \"vitest\";\nimport { buildEnquiry } from \"@/lib/contact\";\n\nfunction fd(fields: Record<string, string>) {\n  const data = new FormData();\n  for (const [k, v] of Object.entries(fields)) data.set(k, v);\n  return data;\n}\n\ndescribe(\"buildEnquiry\", () => {\n  it(\"trims whitespace from all fields\", () => {\n    const { name } = buildEnquiry(fd({ name: \"  Jane  \", email: \"a@b.com\", phone: \"123\" }));\n    expect(name).toBe(\"Jane\");\n  });\n  it(\"omits the product line when product is empty\", () => {\n    const { text } = buildEnquiry(fd({ name: \"Jane\", email: \"a@b.com\", phone: \"123\" }));\n    expect(text).not.toContain(\"Product of interest\");\n  });\n  it(\"includes the product line when product is present\", () => {\n    const { text } = buildEnquiry(fd({ name: \"Jane\", email: \"a@b.com\", phone: \"123\", product: \"PMS\" }));\n    expect(text).toContain(\"Product of interest: PMS\");\n  });\n  it(\"omits the message line when message is only whitespace\", () => {\n    const { text } = buildEnquiry(fd({ name: \"Jane\", email: \"a@b.com\", phone: \"123\", message: \"   \" }));\n    expect(text).not.toContain(\"Message:\");\n  });\n  it(\"handles a completely empty FormData without throwing\", () => {\n    expect(() => buildEnquiry(new FormData())).not.toThrow();\n  });\n});\n```\n\n```tsx\n// src/components/pages/ContactPage.test.tsx (integration, RTL)\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\nimport { render, screen, fireEvent } from \"@testing-library/react\";\nimport ContactPage from \"@/components/pages/ContactPage\";\n\ndescribe(\"ContactPage submission\", () => {\n  beforeEach(() => {\n    vi.stubGlobal(\"open\", vi.fn());\n  });\n\n  it(\"opens a wa.me URL with the encoded enquiry on submit\", () => {\n    render(<ContactPage />);\n    fireEvent.change(screen.getByLabelText(/full name/i), { target: { value: \"Jane Doe\" } });\n    fireEvent.change(screen.getByLabelText(/email address/i), { target: { value: \"jane@example.com\" } });\n    fireEvent.change(screen.getByLabelText(/phone number/i), { target: { value: \"9999999999\" } });\n    fireEvent.click(screen.getByRole(\"button\", { name: /submit via whatsapp/i }));\n\n    expect(window.open).toHaveBeenCalledWith(\n      expect.stringContaining(\"https://wa.me/919205523100?text=\"),\n      \"_blank\",\n      \"noopener,noreferrer\",\n    );\n  });\n\n  it(\"does not send a mailto: when required fields are missing (native validation blocks it)\", () => {\n    const locationSpy = vi.spyOn(window, \"location\", \"get\");\n    render(<ContactPage />);\n    fireEvent.click(screen.getByRole(\"button\", { name: /email instead/i }));\n    // required fields empty -> reportValidity() should return false, no navigation attempted\n    expect(locationSpy).not.toHaveBeenCalled();\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "6. `InsightsIndex.tsx` — category filter logic, untested",
        "content": "\nThe `filtered` derivation (`InsightsIndex.tsx:70-73`) has no test proving: `\"All\"` shows every article, a specific category shows only matching articles, and a category with zero matching articles renders an empty grid without crashing (not currently possible given the fixed `CATEGORIES` list, but worth asserting as a regression guard if a category is ever added without articles).\n\n```tsx\n// src/components/pages/InsightsIndex.test.tsx\nimport { describe, it, expect } from \"vitest\";\nimport { render, screen, fireEvent, within } from \"@testing-library/react\";\nimport InsightsIndex from \"@/components/pages/InsightsIndex\";\nimport { ARTICLES } from \"@/lib/articles\";\n\ndescribe(\"InsightsIndex category filter\", () => {\n  it(\"shows all articles by default\", () => {\n    render(<InsightsIndex />);\n    const links = screen.getAllByRole(\"link\", { name: /read (article|note)/i });\n    expect(links).toHaveLength(ARTICLES.length);\n  });\n\n  it(\"filters to only the selected category\", () => {\n    render(<InsightsIndex />);\n    fireEvent.click(screen.getByRole(\"button\", { name: \"PMS\" }));\n    const expected = ARTICLES.filter((a) => a.category === \"PMS\").length;\n    expect(screen.getAllByRole(\"link\", { name: /read (article|note)/i })).toHaveLength(expected);\n  });\n\n  it(\"marks the active filter button as aria-pressed\", () => {\n    render(<InsightsIndex />);\n    const btn = screen.getByRole(\"button\", { name: \"AIF\" });\n    fireEvent.click(btn);\n    expect(btn).toHaveAttribute(\"aria-pressed\", \"true\");\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "7. Integration test gaps — dynamic route pages",
        "content": "\n`src/app/insights/[slug]/page.tsx` and `src/app/products/[slug]/page.tsx` both call `notFound()` when `getArticle`/`getProduct` returns `undefined` (`insights/[slug]/page.tsx:33`, `products/[slug]/page.tsx:33`) — **completely untested**. Also untested: `generateStaticParams()` producing exactly one entry per slug (no duplicates, no missing entries vs. the registry), and `generateMetadata()` returning `{}` for an unknown slug rather than throwing.\n\n```ts\n// src/app/insights/[slug]/page.test.tsx\nimport { describe, it, expect, vi } from \"vitest\";\n\nvi.mock(\"next/navigation\", () => ({ notFound: vi.fn(() => { throw new Error(\"NEXT_NOT_FOUND\"); }) }));\n\ndescribe(\"insights [slug] page\", () => {\n  it(\"calls notFound() for an unknown slug\", async () => {\n    const { default: Page } = await import(\"@/app/insights/[slug]/page\");\n    await expect(Page({ params: Promise.resolve({ slug: \"unknown\" }) })).rejects.toThrow(\"NEXT_NOT_FOUND\");\n  });\n\n  it(\"generateStaticParams produces one entry per article with no duplicates\", async () => {\n    const { generateStaticParams } = await import(\"@/app/insights/[slug]/page\");\n    const { ARTICLES } = await import(\"@/lib/articles\");\n    const params = generateStaticParams();\n    expect(params).toHaveLength(ARTICLES.length);\n    expect(new Set(params.map((p) => p.slug)).size).toBe(ARTICLES.length);\n  });\n\n  it(\"generateMetadata returns {} instead of throwing for an unknown slug\", async () => {\n    const { generateMetadata } = await import(\"@/app/insights/[slug]/page\");\n    await expect(generateMetadata({ params: Promise.resolve({ slug: \"unknown\" }) })).resolves.toEqual({});\n  });\n});\n```\n\n(Same skeleton applies verbatim to `src/app/products/[slug]/page.tsx` swapping `getProduct`/`PRODUCTS`.)\n\n---\n\n",
        "level": 3
      },
      {
        "title": "Priority summary",
        "content": "| Gap | Risk if unfixed | Priority |\n|---|---|---|\n| No test runner configured at all | Any regression ships silently | P0 — infra |\n| `buildEnquiry` (ContactPage) untested/unexported | Broken lead-gen message with no signal | P0 |\n| `ARTICLES` ↔ `ARTICLE_BODIES` slug integrity | Published article renders with empty body | P0 |\n| Dynamic route `notFound()` paths | 500 instead of 404 on bad slug | P1 |\n| `anchorId`/`buildToc` collision behavior | Broken in-page TOC anchors | P2 |\n| Category filter in `InsightsIndex` | UI regression on filter click | P2 |\n| Data-integrity checks (`products.tsx`, `legal.ts`) | Typo in a `tag`/`id` breaks a page silently | P1 |",
        "level": 3
      }
    ],
