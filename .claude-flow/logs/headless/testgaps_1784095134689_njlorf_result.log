        "code": "describe(\"readingMinutes\", () => {\n  it(\"floors at 1 minute for empty content\", () => {\n    expect(readingMinutes([])).toBe(1);\n  });\n  it(\"counts words across p, ul, and table blocks\", () => {\n    const blocks: RichBlock[] = [\n      { kind: \"p\", text: \"one two three\" },\n      { kind: \"ul\", items: [\"four five\", \"six\"] },\n      { kind: \"table\", columns: [\"a\"], rows: [[\"seven eight\"]] },\n    ];\n    // 8 words / 200 wpm rounds to 1\n    expect(readingMinutes(blocks)).toBe(1);\n  });\n  it(\"rounds up for long content (~400 words -> 2 min)\", () => {\n    const text = Array(400).fill(\"word\").join(\" \");\n    expect(readingMinutes([{ kind: \"p\", text }])).toBe(2);\n  });\n});"
