        "code": "// src/components/site/RichText.test.tsx\nimport { describe, it, expect } from \"vitest\";\nimport { render, screen } from \"@testing-library/react\";\nimport RichText from \"./RichText\";\nimport type { RichBlock } from \"@/lib/content-types\";\n\nconst ALL_KINDS: RichBlock[] = [\n  { kind: \"h2\", text: \"Heading\" },\n  { kind: \"h3\", text: \"Subheading\" },\n  { kind: \"p\", text: \"Paragraph\" },\n  { kind: \"ul\", items: [\"one\", \"two\"] },\n  { kind: \"ol\", items: [\"first\", \"second\"] },\n  { kind: \"quote\", text: \"A quote\" },\n  { kind: \"note\", text: \"A note\" },\n  { kind: \"table\", columns: [\"Col\"], rows: [[\"Cell\"]] },\n];\n\ndescribe(\"RichText\", () => {\n  it.each(ALL_KINDS)(\"renders a $kind block without crashing\", (block) => {\n    expect(() => render(<RichText blocks={[block]} />)).not.toThrow();\n  });\n  it(\"h2 id matches anchorId(text) for in-page TOC links to resolve\", () => {\n    render(<RichText blocks={[{ kind: \"h2\", text: \"What is an AIF?\" }]} />);\n    expect(screen.getByRole(\"heading\", { level: 2 }).id).toBe(\"what-is-an-aif\");\n  });\n  it(\"renders nothing (not a crash) for an unrecognized block kind — flags the missing default case\", () => {\n    const bogus = { kind: \"bogus\" } as unknown as RichBlock;\n    const { container } = render(<RichText blocks={[bogus]} />);\n    expect(container.textContent).toBe(\"\");\n  });\n});"
