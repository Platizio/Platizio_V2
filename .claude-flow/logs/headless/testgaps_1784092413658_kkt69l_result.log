        "code": "// After exporting `buildEnquiry` from ContactPage.tsx:\nimport { describe, it, expect } from \"vitest\";\nimport { buildEnquiry } from \"./ContactPage\";\n\nfunction fd(entries: Record<string, string>) {\n  const f = new FormData();\n  for (const [k, v] of Object.entries(entries)) f.set(k, v);\n  return f;\n}\n\ndescribe(\"buildEnquiry\", () => {\n  it(\"trims whitespace from all fields\", () => {\n    const { name } = buildEnquiry(fd({ name: \"  Asha  \", email: \"a@b.com\", phone: \"123\" }));\n    expect(name).toBe(\"Asha\");\n  });\n  it(\"omits the product line when product is empty\", () => {\n    const { text } = buildEnquiry(fd({ name: \"A\", email: \"a@b.com\", phone: \"1\", product: \"\" }));\n    expect(text).not.toContain(\"Product of interest:\");\n  });\n  it(\"omits the message line when message is empty\", () => {\n    const { text } = buildEnquiry(fd({ name: \"A\", email: \"a@b.com\", phone: \"1\", message: \"\" }));\n    expect(text).not.toContain(\"Message:\");\n  });\n  it(\"includes product and message when present\", () => {\n    const { text } = buildEnquiry(fd({ name: \"A\", email: \"a@b.com\", phone: \"1\", product: \"PMS\", message: \"Hi\" }));\n    expect(text).toContain(\"Product of interest: PMS\");\n    expect(text).toContain(\"Message: Hi\");\n  });\n  it(\"treats a whitespace-only field as empty (no 'Message: ' line)\", () => {\n    const { text } = buildEnquiry(fd({ name: \"A\", email: \"a@b.com\", phone: \"1\", message: \"   \" }));\n    expect(text).not.toContain(\"Message:\");\n  });\n});"
