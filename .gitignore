# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent/tooling scratch dirs. Only .claude/worktrees/ is excluded, not
# .claude/ itself — launch.json and proven-config.json under it are tracked.
# Keep in sync with the globalIgnores list in eslint.config.mjs.
/.claude/worktrees/
/.superpowers/
/.playwright-mcp/

# claude-flow local state: daemon pid/state, metrics and headless run logs.
# Uses /* rather than a trailing slash so git still descends into the folder
# and the negation below can take effect — a directory exclude is never
# descended into, and the un-ignore would be silently dead.
.claude-flow/*
!.claude-flow/harness-active-policy.json
